* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0f172a;
}

h1 {
    text-align: center;
    color: white;
    margin-bottom: 20px;
}

h2 {
    color: white;
    text-align: center;
    margin: 20px 0 10px;
}

body > div {
    background: #1e293b;
    padding: 25px;
    border-radius: 20px;
    width: 360px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

#display {
    width: 100%;
    height: 70px;
    border: none;
    outline: none;
    border-radius: 12px;
    background: #020617;
    color: white;
    font-size: 30px;
    text-align: right;
    padding: 10px 15px;
    margin-bottom: 15px;
}

button {
    width: 70px;
    height: 55px;
    margin: 4px;
    border: none;
    border-radius: 12px;
    background: #334155;
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    background: #475569;
    transform: scale(1.05);
}

button:active {
    transform: scale(0.95);
}

button:last-child {
    background: #2563eb;
}

button:last-child:hover {
    background: #1d4ed8;
}

hr {
    border: none;
    height: 1px;
    background: #475569;
    margin: 20px 0;
}
